# ClaimSight environment variables
# Copy to .env and fill in your values. Never commit .env.

# --- Database (Supabase free tier or local Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/claimsight

# --- LLM providers ---
# Groq for cheap, fast specialist agents (free tier)
GROQ_API_KEY=
# Anthropic for adjudicator and critic (small spend, capped)
ANTHROPIC_API_KEY=

# --- Observability ---
# Langfuse Cloud free tier or self-hosted
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Application config ---
LOG_LEVEL=INFO
ENV=development

# --- Cost guardrails (hard caps, fail-safe) ---
MAX_DAILY_USD=2.00
MAX_PER_CLAIM_USD=0.10
